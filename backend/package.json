{
  "name": "voixify-backend",
  "version": "1.0.0",
  "description": "Voixify backend proxy - LLM correction (Ollama). Whisper is called directly from the Electron main process.",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "build": "esbuild src/index.js --bundle --platform=node --target=node18 --outfile=dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "nodemon": "^3.0.2",
    "supertest": "^7.0.0",
    "vitest": "^4.1.5"
  }
}
