{
    "name": "voixify",
    "version": "2.0.0",
    "description": "Premium AI dictation app — Voice to text with LLM correction",
    "author": "Brainditech",
    "main": "electron.cjs",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node --no-deprecation node_modules/concurrently/dist/bin/concurrently.js -k \"node --no-deprecation ../backend/src/index.js\" \"vite\" \"wait-on http://localhost:5173 && electron --no-deprecation .\"",
        "build": "vite build",
        "preview": "vite preview",
        "electron": "electron --no-deprecation .",
        "dist": "npm run build && electron-builder"
    },
    "dependencies": {
        "dotenv": "^17.3.1",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "zustand": "^4.4.7"
    },
    "devDependencies": {
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@vitejs/plugin-react": "^5.2.0",
        "concurrently": "^8.2.2",
        "electron": "^41.2.2",
        "electron-builder": "^26.8.1",
        "png-to-ico": "^3.0.1",
        "typescript": "^5.9.3",
        "vite": "^7.3.2",
        "wait-on": "^7.2.0"
    },
    "build": {
        "appId": "com.brainditech.voixify",
        "productName": "Voixify",
        "win": {
            "target": "nsis",
            "icon": "assets/icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Voixify"
        },
        "files": [
            "**/*",
            "!dist-electron",
            "!node_modules/.cache"
        ],
        "extraResources": [
            {
                "from": "../backend",
                "to": "backend",
                "filter": [
                    "src/**/*",
                    "package.json",
                    "node_modules/**/*"
                ]
            }
        ],
        "directories": {
            "output": "dist-electron-v2"
        }
    }
}