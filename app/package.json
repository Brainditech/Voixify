{
    "name": "voixify",
    "version": "2.0.0",
    "description": "Premium AI dictation app — Voice to text with LLM correction",
    "author": "Brainditech",
    "main": "electron.cjs",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node --no-deprecation node_modules/concurrently/dist/bin/concurrently.js -k \"node --no-deprecation ../backend/src/index.js\" \"vite\" \"wait-on http://localhost:5173 && electron --no-deprecation .\"",
        "build": "vite build",
        "preview": "vite preview",
        "electron": "electron --no-deprecation .",
        "dist": "npm run build && npm run build --prefix ../backend && electron-builder",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "dotenv": "^17.3.1",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "zustand": "^4.4.7"
    },
    "devDependencies": {
        "@electron/fuses": "^2.1.1",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.1.0",
        "@testing-library/user-event": "^14.5.2",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@vitejs/plugin-react": "^5.2.0",
        "concurrently": "^8.2.2",
        "electron": "^41.2.2",
        "electron-builder": "^26.8.1",
        "jsdom": "^25.0.1",
        "png-to-ico": "^3.0.1",
        "typescript": "^5.9.3",
        "vite": "^8.0.16",
        "vitest": "^4.1.5",
        "wait-on": "^7.2.0"
    },
    "build": {
        "appId": "com.brainditech.voixify",
        "productName": "Voixify",
        "afterPack": "build/afterPack.cjs",
        "win": {
            "target": "nsis",
            "icon": "assets/icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Voixify"
        },
        "files": [
            "**/*",
            "!dist-electron",
            "!node_modules/.cache"
        ],
        "extraResources": [
            {
                "from": "../backend/dist/server.js",
                "to": "backend/server.js"
            }
        ],
        "directories": {
            "output": "dist-electron-v2"
        }
    }
}
